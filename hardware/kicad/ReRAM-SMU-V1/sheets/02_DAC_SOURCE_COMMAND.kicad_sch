	(global_label "SPI1_SCK" (shape output) (at 50.80 88.90 0) (effects (font (size 1.27 1.27))) (uuid "b8888888-8888-4888-8888-b88888888888"))
	(global_label "CS_DAC" (shape output) (at 55.88 88.90 0) (effects (font (size 1.27 1.27))) (uuid "b9999999-9999-4999-8999-b99999999999"))
