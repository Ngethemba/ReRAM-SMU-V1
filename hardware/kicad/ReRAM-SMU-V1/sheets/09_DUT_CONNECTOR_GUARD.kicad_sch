	; ─── Section A: Connector ───
	(text "A — DUT connector — 4-wire Kelvin (FORCE_HI/LO + SENSE_HI/LO + SHIELD/GUARD)" (at 10 22 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Primary: 4x isolated 4mm banana jacks (Keystone 575-4 / Hirschmann PKI 10A) — red FORCE_HI, black FORCE_LO, green SENSE_HI, blue SENSE_LO. Pitch 19.05mm, isolated from chassis via nylon washers. Alternative footprint: 5-pin 3.5mm screw terminal (Phoenix MC 1.5/5-G) + 2-pin sense header. Both footprints present, one stuffed per build variant." (at 10 26 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "A1 FORCE_HI/LO — power path: trace 1mm (2oz) / 2mm neck near jack, <20mm to LT1970 R_iso node and shunt top. Via stitch to inner plane not on signal. Kelvin tap: FORCE_LO picked at jack solder lug + separate Kelvin trace to shunt SENSE_P and SENSE_LO buffer — star at lug." (at 10 30 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "A2 SENSE_HI/LO — high-Z buffered (>10G, OPA140, 10pA max): trace 0.3mm, length 15-20mm, guarded on both sides + via fence. Shielded twisted pair if cable >100mm. Input Cin 3pF + trace 1pF -> C_down contribution 4pF budget." (at 10 34 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Connector:Banana_Jack_4") (at 40 50 0) (unit 1) (uuid "j-dut-banana-010") (property "Reference" "J9A" (at 40 56 0) (effects (font (size 1 1)))) (property "Value" "4x Banana 4mm isolated — FORCE_HI(1)/FORCE_LO(2)/SENSE_HI(3)/SENSE_LO(4)" (at 40 42 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Connector_Banana:Banana_Jack_4xIsolated_19.05mm" (at 40 40 0) (effects (font (size 0.7 0.7)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 70 50 0) (unit 1) (uuid "r-force-lo-star-011") (property "Reference" "R9A" (at 70 53 0) (effects (font (size 1 1)))) (property "Value" "0R 1206 star jumper — FORCE_LO Kelvin pick" (at 70 49 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_1206_3216Metric" (at 70 47 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(text "A3 SHIELD/GUARD: enclosure shield (chassis) tied to FORCE_LO via 1M||10nF (bleed) + 1nF HF. GUARD copper: top ring 0.5mm wide + inner plane stitched every 5mm, NO-MASK exposed. Driven-guard amp footprint (SO-8 OPA140) DNP — if stuffed, power from +5V/-5V rails, input tracks SENSE_HI, output -> guard via 100R+1nF, load 10-50pF. REV-A: guard is passive keepout/grounded-shield via 1M||10nF, NOT tied to GND plane." (at 10 60 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 68 0) (unit 1) (uuid "r-shield-bleed-012") (property "Reference" "R9B" (at 30 71 0) (effects (font (size 1 1)))) (property "Value" "1M 1% — shield bleed to FORCE_LO" (at 30 67 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 30 65 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 40 68 0) (unit 1) (uuid "c-shield-bleed-013") (property "Reference" "C9A" (at 40 71 0) (effects (font (size 1 1)))) (property "Value" "10nF 50V X7R" (at 40 67 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0805_2012Metric" (at 40 65 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 50 68 0) (unit 1) (uuid "c-shield-hf-014") (property "Reference" "C9B" (at 50 71 0) (effects (font (size 1 1)))) (property "Value" "1nF C0G — HF shield" (at 50 67 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 50 65 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 70 68 0) (unit 1) (uuid "r-guard-series-015") (property "Reference" "R9C" (at 70 71 0) (effects (font (size 1 1)))) (property "Value" "DNP 100R — guard amp series" (at 70 67 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 70 65 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 80 68 0) (unit 1) (uuid "c-guard-load-016") (property "Reference" "C9C" (at 80 71 0) (effects (font (size 1 1)))) (property "Value" "DNP 1nF — guard load stab" (at 80 67 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 80 65 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(text "CRITICAL: No grounded guard ring around SENSE_HI tied to GND plane — that injects leakage (V_sense - 0)/R_surface. Only keepout or driven guard tracking SENSE_HI. Guard copper isolated from GND plane >=0.5mm (FR4 >10G)." (at 10 76 0) (effects (font (size 0.7 0.7) (thickness 0.2)) (justify left)))

	; ─── Section B: Keepout / geometry ───
	(text "B — Keepout & layout rules (enforce in PCB, not just schematic)" (at 10 85 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Rule GW-01: Guard ring 0.5mm wide, gap 0.3mm to SENSE trace, exposed copper (no mask), inner guard plane flood under high-Z zone, stitched every 5mm via 0.3mm drill. Keepout: no vias on SENSE_HI/LO signal trace (top-layer only to buffer input). No X7R on high-Z: C0G/NP0 only; no soldermask over ring+trace (ionic film stays on guard)." (at 10 89 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "Rule GW-02: FORCE_HI/LO keep 1mm clearance to SENSE. Shield pin adjacent to FORCE_LO for star. Connector center to first buffer <20mm. Cable downstream C budget 80pF @5V gentle (100pF=1.25nJ) / 150pF @5V standard (2nJ) — downstream includes: jack 5pF + trace 2pF + relay Coff 1-3pF + buffer Cin 3pF + ESD 0.5pF + DUT 5pF. C_down marked on layout." (at 10 93 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "Rule GW-03: Cleaning: post-assembly wash (Vigon A200), no-clean flux prohibited near guard zone, conformal coat option (Humiseal) with guard ring masked during coat. Isolation test: 5V bias guard-to-sense >10G per IPC." (at 10 97 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 105 0) (unit 1) (uuid "r-guard-isol-020") (property "Reference" "R9D" (at 30 108 0) (effects (font (size 1 1)))) (property "Value" "DNP 0R — guard isolate check (measure)" (at 30 101 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 99 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section C: ESD / protection ───
	(text "C — ESD / OVP — low-leak, low-C (keep C_down, protect LRS snap)" (at 10 115 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "FORCE_HI/LO: PESD5V0S1BSF or ESD7384 (0.35-0.5pF, 6V clamp) — leakage <1uA at 25C acceptable on power path (not on sense). Bidirectional TVS SMAJ5.0A DNP for cable EFT. Series 10R thin-film before DUT to limit ESD dump." (at 10 119 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "SENSE_HI/LO: NO ESD stuffed in REV-A precision path (leakage budget <10pA). Footprint provision: ESD7384 0.35pF DNP — characterization required (typical 1nA @85C fails 1nA MUC). If ESD needed for handling, use guard-driven ESD (anode to guard, not GND) or external dongle. Clamp diodes: BAT54S to guard for SENSE, to FORCE_LO for FORCE. Verify leakage 10pA on 1M range." (at 10 123 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 131 0) (unit 1) (uuid "r-esd-ser-force-021") (property "Reference" "R9E" (at 30 134 0) (effects (font (size 1 1)))) (property "Value" "10R 1% — FORCE ESD series" (at 30 130 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 128 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 50 131 0) (unit 1) (uuid "r-esd-ser-sense-022") (property "Reference" "R9F" (at 50 134 0) (effects (font (size 1 1)))) (property "Value" "DNP 1k — SENSE series (if ESD stuffed)" (at 50 130 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 50 128 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section D: Test point policy ───
	(text "D — Test point policy (normal vs low-C pads)" (at 10 142 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Normal impedance TPs (through-hole Keystone 5002 red/black, loop for scope probe): TP_FORCE_HI, TP_FORCE_LO (Kelvin lugs), TP_VSET, TP_DAC_OUT, TP_ADC_IN_P/N, TP_ENABLE (1k series +100pF), TP_ISRC/ISNK (1k), TP_POR, TP_3V3, TP_5V, TP_12V, TP_GND star. Each with 100mil header alt." (at 10 146 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "Low-capacitance pads for SENSE_HI/LO: 1mm bare copper circular pad + guard ring, no through-hole, no mask, labelled TP_SENSE_HI_PAD / TP_SENSE_LO_PAD. Added C ~1.5-2pF pad-to-guard (budgeted). Probe via active probe (>1G // 0.5pF) or flying lead; no standard 100pF scope probe on SENSE during nA measurement. DNP 0R jumper to disconnect pad for ultimate leak test." (at 10 150 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "A/B TP strategy for calibration: Jumper JP9A (FORCE_SENSE tie) DNP — shorts SENSE_HI to FORCE_HI and SENSE_LO to FORCE_LO for 2-wire calibration via external DMM (4-wire short). Kelvin vs non-Kelvin delta measured on 10R/1k dummy." (at 10 154 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 162 0) (unit 1) (uuid "r-tp-force-030") (property "Reference" "TP_FORCE_HI" (at 30 165 0) (effects (font (size 1 1)))) (property "Value" "TP FORCE_HI — Keystone 5002 + 2mm pad" (at 30 158 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "TestPoint:TestPoint_Loop_D2.54mm_Drill1.5mm" (at 30 156 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 45 162 0) (unit 1) (uuid "r-tp-sense-hi-031") (property "Reference" "TP_SENSE_HI_PAD" (at 45 165 0) (effects (font (size 1 1)))) (property "Value" "TP SENSE_HI — 1mm bare pad + guard, LOW-C" (at 45 158 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "TestPoint:Pad_1mm_Bare_GuardRing" (at 45 156 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 60 162 0) (unit 1) (uuid "r-tp-sense-lo-032") (property "Reference" "TP_SENSE_LO_PAD" (at 60 165 0) (effects (font (size 1 1)))) (property "Value" "TP SENSE_LO — 1mm bare pad + guard, LOW-C" (at 60 158 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "TestPoint:Pad_1mm_Bare_GuardRing" (at 60 156 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 75 162 0) (unit 1) (uuid "r-tp-shield-033") (property "Reference" "TP_SHIELD" (at 75 165 0) (effects (font (size 1 1)))) (property "Value" "TP SHIELD — star point" (at 75 158 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "TestPoint:TestPoint_Loop_D2.54mm_Drill1.5mm" (at 75 156 0) (effects (font (size 0.8 0.8)) (hide yes))) )
