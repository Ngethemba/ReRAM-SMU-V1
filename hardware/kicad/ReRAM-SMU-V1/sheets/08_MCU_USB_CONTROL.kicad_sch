	(symbol (lib_id "Device:R") (at 50.04 118.11 0) (unit 1) (uuid "r-i2c-pu-041") (property "Reference" "R8L" (at 50.04 120.90 0) (effects (font (size 1 1)))) (property "Value" "2.2k — I2C SDA pull-up" (at 50.04 114.05 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 50.04 112.01 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 59.94 118.11 0) (unit 1) (uuid "r-i2c-pu2-042") (property "Reference" "R8M" (at 59.94 120.90 0) (effects (font (size 1 1)))) (property "Value" "2.2k — I2C SCL pull-up" (at 59.94 114.05 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 59.94 112.01 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 74.93 118.11 0) (unit 1) (uuid "r-cs-pu-043") (property "Reference" "R8N" (at 74.93 120.90 0) (effects (font (size 1 1)))) (property "Value" "10k — CS pull-up (safe high)" (at 74.93 114.05 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 74.93 112.01 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section D: Relay drivers ───
	(text "D — Relay drivers (6 shunt ranges + 1 spare) — coil suppression, return isolation" (at 9.91 128.02 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Driver: ULN2803A (octal Darlington) or discrete 2N7002 N-FET per relay. Coil: Coto 9007 5V 500R 10mA. Flyback: internal diode in ULN2803 to +5V_RELAY + external 1N4148W across coil + RC snubber 100R+100nF across contacts (relay Coff 1pF helps C_down). Return: relay GND star at connector, ferrite bead to digital GND + 10uF bulk; coil supply +5V_RELAY via separate LC (10uH+47uF) to isolate ADC supply." (at 9.91 132.08 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "BBM guarantee: hardware break-before-make via RC delay (10k+10uF = 100ms staggering) OR MCU sequences: OFF all -> wait 5ms -> ON selected -> wait 10ms settle -> measure. De-energized default = 1M shunt (safe HRS). GPIO: PC0-5 drive IN1-6, PC9 relay enable master (active high, 10k pull-down — relays off if MCU tri-stated)." (at 9.91 135.89 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 29.97 145.03 0) (unit 1) (uuid "r-relay-en-pd-050") (property "Reference" "R8P" (at 29.97 148.08 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — RELAY_EN master" (at 29.97 140.97 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 29.97 138.94 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 39.88 145.03 0) (unit 1) (uuid "c-relay-bulk-051") (property "Reference" "C8E" (at 39.88 148.08 0) (effects (font (size 1 1)))) (property "Value" "47uF 10V X5R — relay bulk" (at 39.88 140.97 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_1206_3216Metric" (at 39.88 138.94 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 55.12 145.03 0) (unit 1) (uuid "l-relay-filt-052") (property "Reference" "L8B" (at 55.12 148.08 0) (effects (font (size 1 1)))) (property "Value" "10uH 500mA — relay LC" (at 55.12 140.97 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Inductor_SMD:L_0805_2012Metric" (at 55.12 138.94 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section E: Status / IO + ENABLE ───
	(text "E — Digital I/O + ENABLE / ISRC/ISNK / FAULT + status LEDs" (at 9.91 154.94 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Inputs (3.3V, 5V-tolerant, with 10k pull-up/down + 100pF filter + 100R series): ISRC (PB0, INT), ISNK (PB1, INT), FAULT_LATCH_QB (PC10, INT), SENSE_OPEN (PC11, INT), POR (PA0, INT). Outputs: MCU_ENABLE_REQ (PA15, push-pull, 10k pull-down safe default low = disabled), FW_CLEAR (PB2, pulse), RELAY_EN, LEDs." (at 9.91 159.00 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "ENABLE generation (hardware): ENABLE = MCU_ENABLE_REQ AND NOT(FAULT_LATCH_Q). Implemented via SN74LVC1G08 AND + 10k pull-down on ENABLE node. FAULT_LATCH_Q high forces ENABLE low regardless of MCU. Supervisor (STM809-3V) holds POR low 240ms + drives FAULT latch SET + pulls ENABLE low + holds NRST low. Watchdog timeout also triggers supervisor." (at 9.91 163.07 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "LEDs: D8A green POWER (3.3V), D8B blue USB ENUM (PA8 MCO), D8C yellow COMPLIANCE (ISRC|ISNK), D8D red FAULT (Q). Each 1k + LED to GND. Test points: TP_ENABLE (via 1k series, 100pF), TP_ISRC/ISNK (1k), TP_POR, TP_SWD." (at 9.91 166.88 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 29.97 175.01 0) (unit 1) (uuid "r-enable-pd-060") (property "Reference" "R8Q" (at 29.97 178.05 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — ENABLE hw-safe" (at 29.97 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 29.97 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 44.96 175.01 0) (unit 1) (uuid "r-mcu-req-pd-061") (property "Reference" "R8R" (at 44.96 178.05 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — MCU_ENABLE_REQ" (at 44.96 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 44.96 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 59.94 175.01 0) (unit 1) (uuid "r-isrc-pull-062") (property "Reference" "R8S" (at 59.94 178.05 0) (effects (font (size 1 1)))) (property "Value" "10k pull-up 3.3V — ISRC input" (at 59.94 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 59.94 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 70.10 175.01 0) (unit 1) (uuid "r-isnk-pull-063") (property "Reference" "R8T" (at 70.10 178.05 0) (effects (font (size 1 1)))) (property "Value" "10k pull-up 3.3V — ISNK input" (at 70.10 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 70.10 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 80.01 175.01 0) (unit 1) (uuid "r-led-064") (property "Reference" "R8U" (at 80.01 178.05 0) (effects (font (size 1 1)))) (property "Value" "1k — FAULT LED" (at 80.01 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 80.01 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 85.09 175.01 0) (unit 1) (uuid "c-enable-filt-065") (property "Reference" "C8F" (at 85.09 178.05 0) (effects (font (size 1 1)))) (property "Value" "100pF C0G — ENABLE filter" (at 85.09 170.94 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 85.09 168.91 0) (effects (font (size 0.8 0.8)) (hide yes))) )

