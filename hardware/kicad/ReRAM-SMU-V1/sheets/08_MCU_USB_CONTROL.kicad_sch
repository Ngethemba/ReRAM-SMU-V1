	(symbol (lib_id "Device:R") (at 50.04 85.09 0) (unit 1) (uuid "r-cc2-031") (property "Reference" "R8F" (at 50.04 87.88 0) (effects (font (size 1 1)))) (property "Value" "5.1k 1% — CC2 to GND" (at 50.04 81.03 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 50.04 78.99 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 70.10 85.09 0) (unit 1) (uuid "r-usb-dp-032") (property "Reference" "R8G" (at 70.10 87.88 0) (effects (font (size 1 1)))) (property "Value" "22R — DP series" (at 70.10 81.03 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 70.10 78.99 0) (effects (font (size 0.8 0.8)) (hide yes))) )
