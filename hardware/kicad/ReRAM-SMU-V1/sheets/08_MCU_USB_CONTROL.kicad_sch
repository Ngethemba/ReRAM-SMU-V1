	(symbol (lib_id "Device:R") (at 40 60 0) (unit 1) (uuid "r-swd2-024") (property "Reference" "R8D" (at 40 63 0) (effects (font (size 1 1)))) (property "Value" "22R — SWCLK series" (at 40 56 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 40 54 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 55 60 0) (unit 1) (uuid "r-avdda-filt-025") (property "Reference" "L8A" (at 55 63 0) (effects (font (size 1 1)))) (property "Value" "BLM18PG600SN1D ferrite 600R@100M" (at 55 56 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Inductor_SMD:L_0603_1608Metric" (at 55 54 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 65 60 0) (unit 1) (uuid "c-avdda-026") (property "Reference" "C8B" (at 65 63 0) (effects (font (size 1 1)))) (property "Value" "4.7uF X7R + 100nF C0G @VDDA" (at 65 56 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 65 54 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section B: USB-C ───
	(text "B — USB-C (Full Speed device, CDC/TMC, 12 Mbps) — power via +5V USB, not DUT power" (at 10 70 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Connector: USB-C 16-pin mid-mount (GCT USB4085 or Würth 632712000011). CC1/CC2 each 5.1k 1% to GND (UFP). D+/D- via USBLC6-2SC6 ESD (0.35pF, 6V clamp) + 22R series + 33pF DNP. VBUS sense via divider 10k/10k to PA9 (or 5V-tolerant). Shield to chassis via 1M||10nF + 1nF HF + 0R option. VBUS 10uF + 100nF decoupling. USB_DM/DP have internal 1.5k pull-up via STM32 USB peripheral (software-controlled)." (at 10 74 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "Isolation provision: footprint for ADuM3160+isolated DC/DC (e.g., Murata NME0505SC) DNP in REV-A — direct USB ships with ground-loop warning. Pair length matched 90R diff. Keep away from ADC/shunt region >20mm." (at 10 78 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 85 0) (unit 1) (uuid "r-cc1-030") (property "Reference" "R8E" (at 30 88 0) (effects (font (size 1 1)))) (property "Value" "5.1k 1% — CC1 to GND" (at 30 81 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 79 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 50 85 0) (unit 1) (uuid "r-cc2-031") (property "Reference" "R8F" (at 50 88 0) (effects (font (size 1 1)))) (property "Value" "5.1k 1% — CC2 to GND" (at 50 81 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 50 79 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 70 85 0) (unit 1) (uuid "r-usb-dp-032") (property "Reference" "R8G" (at 70 88 0) (effects (font (size 1 1)))) (property "Value" "22R — DP series" (at 70 81 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 70 79 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 80 85 0) (unit 1) (uuid "r-usb-dm-033") (property "Reference" "R8H" (at 80 88 0) (effects (font (size 1 1)))) (property "Value" "22R — DM series" (at 80 81 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 80 79 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 30 92 0) (unit 1) (uuid "r-usb-shield-034") (property "Reference" "R8J" (at 30 95 0) (effects (font (size 1 1)))) (property "Value" "1M — shield bleed" (at 30 91 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 30 89 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 40 92 0) (unit 1) (uuid "c-usb-shield-035") (property "Reference" "C8C" (at 40 95 0) (effects (font (size 1 1)))) (property "Value" "10nF 50V X7R — shield" (at 40 91 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0805_2012Metric" (at 40 89 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 50 92 0) (unit 1) (uuid "c-usb-shield2-036") (property "Reference" "C8D" (at 50 95 0) (effects (font (size 1 1)))) (property "Value" "1nF HF — shield" (at 50 91 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 50 89 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section C: SPI/I2C to DAC/ADC + temp ───
	(text "C — SPI/I2C: SPI1 (DAC AD5764), SPI2 (ADC ADS1262), I2C1 (TMP117 x3) + relay GPIO" (at 10 102 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "SPI1: PA5 SCK 10MHz, PA6 MISO, PA7 MOSI, PA4 CS_DAC (active low, 10k pull-up). SPI2: PB13 SCK 8MHz, PB14 MISO, PB15 MOSI, PB12 CS_ADC. Both with 22R series + 100pF DNP for EMI. I2C1: PB6 SCL 400kHz, PB7 SDA + 2.2k pull-ups. DAC LDAC -> PC6, CLR -> PC7. ADC DRDY -> PA10 interrupt, START -> PA11, RESET -> PC8." (at 10 106 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "A/B SPI are on separate buses to avoid DAC/ADC contention; DMA1 Ch1 for DAC sweep ramp, DMA1 Ch2 for ADC burst. Temp sensors TMP117 @0.1C accuracy on I2C: U10 output stage, U11 shunt block, U12 reference. Address strapping 48/49/4A." (at 10 110 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 118 0) (unit 1) (uuid "r-spi-sck-040") (property "Reference" "R8K" (at 30 121 0) (effects (font (size 1 1)))) (property "Value" "22R — SPI SCK series" (at 30 114 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 112 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 50 118 0) (unit 1) (uuid "r-i2c-pu-041") (property "Reference" "R8L" (at 50 121 0) (effects (font (size 1 1)))) (property "Value" "2.2k — I2C SDA pull-up" (at 50 114 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 50 112 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 60 118 0) (unit 1) (uuid "r-i2c-pu2-042") (property "Reference" "R8M" (at 60 121 0) (effects (font (size 1 1)))) (property "Value" "2.2k — I2C SCL pull-up" (at 60 114 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 60 112 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 75 118 0) (unit 1) (uuid "r-cs-pu-043") (property "Reference" "R8N" (at 75 121 0) (effects (font (size 1 1)))) (property "Value" "10k — CS pull-up (safe high)" (at 75 114 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 75 112 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section D: Relay drivers ───
	(text "D — Relay drivers (6 shunt ranges + 1 spare) — coil suppression, return isolation" (at 10 128 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Driver: ULN2803A (octal Darlington) or discrete 2N7002 N-FET per relay. Coil: Coto 9007 5V 500R 10mA. Flyback: internal diode in ULN2803 to +5V_RELAY + external 1N4148W across coil + RC snubber 100R+100nF across contacts (relay Coff 1pF helps C_down). Return: relay GND star at connector, ferrite bead to digital GND + 10uF bulk; coil supply +5V_RELAY via separate LC (10uH+47uF) to isolate ADC supply." (at 10 132 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "BBM guarantee: hardware break-before-make via RC delay (10k+10uF = 100ms staggering) OR MCU sequences: OFF all -> wait 5ms -> ON selected -> wait 10ms settle -> measure. De-energized default = 1M shunt (safe HRS). GPIO: PC0-5 drive IN1-6, PC9 relay enable master (active high, 10k pull-down — relays off if MCU tri-stated)." (at 10 136 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 145 0) (unit 1) (uuid "r-relay-en-pd-050") (property "Reference" "R8P" (at 30 148 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — RELAY_EN master" (at 30 141 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 139 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 40 145 0) (unit 1) (uuid "c-relay-bulk-051") (property "Reference" "C8E" (at 40 148 0) (effects (font (size 1 1)))) (property "Value" "47uF 10V X5R — relay bulk" (at 40 141 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_1206_3216Metric" (at 40 139 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 55 145 0) (unit 1) (uuid "l-relay-filt-052") (property "Reference" "L8B" (at 55 148 0) (effects (font (size 1 1)))) (property "Value" "10uH 500mA — relay LC" (at 55 141 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Inductor_SMD:L_0805_2012Metric" (at 55 139 0) (effects (font (size 0.8 0.8)) (hide yes))) )

	; ─── Section E: Status / IO + ENABLE ───
	(text "E — Digital I/O + ENABLE / ISRC/ISNK / FAULT + status LEDs" (at 10 155 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Inputs (3.3V, 5V-tolerant, with 10k pull-up/down + 100pF filter + 100R series): ISRC (PB0, INT), ISNK (PB1, INT), FAULT_LATCH_QB (PC10, INT), SENSE_OPEN (PC11, INT), POR (PA0, INT). Outputs: MCU_ENABLE_REQ (PA15, push-pull, 10k pull-down safe default low = disabled), FW_CLEAR (PB2, pulse), RELAY_EN, LEDs." (at 10 159 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "ENABLE generation (hardware): ENABLE = MCU_ENABLE_REQ AND NOT(FAULT_LATCH_Q). Implemented via SN74LVC1G08 AND + 10k pull-down on ENABLE node. FAULT_LATCH_Q high forces ENABLE low regardless of MCU. Supervisor (STM809-3V) holds POR low 240ms + drives FAULT latch SET + pulls ENABLE low + holds NRST low. Watchdog timeout also triggers supervisor." (at 10 163 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "LEDs: D8A green POWER (3.3V), D8B blue USB ENUM (PA8 MCO), D8C yellow COMPLIANCE (ISRC|ISNK), D8D red FAULT (Q). Each 1k + LED to GND. Test points: TP_ENABLE (via 1k series, 100pF), TP_ISRC/ISNK (1k), TP_POR, TP_SWD." (at 10 167 0) (effects (font (size 0.7 0.7)) (justify left)))
	(symbol (lib_id "Device:R") (at 30 175 0) (unit 1) (uuid "r-enable-pd-060") (property "Reference" "R8Q" (at 30 178 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — ENABLE hw-safe" (at 30 171 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 30 169 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 45 175 0) (unit 1) (uuid "r-mcu-req-pd-061") (property "Reference" "R8R" (at 45 178 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — MCU_ENABLE_REQ" (at 45 171 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 45 169 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 60 175 0) (unit 1) (uuid "r-isrc-pull-062") (property "Reference" "R8S" (at 60 178 0) (effects (font (size 1 1)))) (property "Value" "10k pull-up 3.3V — ISRC input" (at 60 171 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 60 169 0) (effects (font (size 0.8 0.8)) (hide yes))) )
