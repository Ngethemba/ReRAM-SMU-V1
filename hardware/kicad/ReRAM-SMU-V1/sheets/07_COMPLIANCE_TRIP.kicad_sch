	(symbol (lib_id "Device:D_Schottky") (at 35 160 0) (unit 1) (uuid "d-or-por-033") (property "Reference" "D7C" (at 35 163 0) (effects (font (size 1 1)))) (property "Value" "BAT54S — POR OR" (at 35 156 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Diode_SMD:D_SOT-23" (at 35 154 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:R") (at 50 160 0) (unit 1) (uuid "r-fw-clear-pull-034") (property "Reference" "R7P" (at 50 163 0) (effects (font (size 1 1)))) (property "Value" "10k pull-down — FW_CLEAR" (at 50 156 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 50 154 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(symbol (lib_id "Device:C") (at 55 160 0) (unit 1) (uuid "c-fw-clear-035") (property "Reference" "C7E" (at 55 163 0) (effects (font (size 1 1)))) (property "Value" "1nF — FW_CLEAR debounce" (at 55 156 0) (effects (font (size 0.7 0.7)))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 55 154 0) (effects (font (size 0.8 0.8)) (hide yes))) )
	(text "Latch truth: SET prioritized over RESET (asynchronous). Firmware CLEAR ignored while FAST_TRIP or SENSE_OPEN still asserted. Dwell: MCU must wait 10ms after fault clears + confirm Imeas < Itrip before pulsing CLEAR. Watchdog timeout also asserts POR-equivalent." (at 10 168 0) (effects (font (size 0.7 0.7)) (justify left)))
	(text "ENABLE path: MCU_ENABLE_REQ (GPIO, pulled low 10k default) AND NOT(Q) via SN74LVC1G08 or discrete NPN. ENABLE high = ON, low = OFF (LT1970 active-high enable with 10k pull-down to GND for hardware-safe POR disabled). Latch Q high forces ENABLE low regardless of MCU." (at 10 172 0) (effects (font (size 0.7 0.7)) (justify left)))

	; ─── Section E: SOA auxiliary ───
	(text "E — SOA / Supply fault auxiliary (provision)" (at 10 180 0) (effects (font (size 1 1) (thickness 0.2))))
	(text "Coarse SOA at +/-5V/+/-10mA: 5V*12mA=60mW -> single I-trip at 13mA already enforces hyperbola. Optional AD633 multiplier footprint DNP for future higher-power. Supply fault: +/-12V supervisors ORed via diodes to same SET node." (at 10 184 0) (effects (font (size 0.7 0.7)) (justify left)))

